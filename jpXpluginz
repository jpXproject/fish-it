        <!-- Notifications -->
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title"><div class="panel-title-dot" style="background:var(--danger);box-shadow:0 0 8px var(--danger)"></div> Event Log</div>
            <button class="btn btn-ghost" style="padding:4px 10px;font-size:11px">Clear</button>
          </div>
          <div class="notify-item">
            <div class="notify-dot green"></div>
            <div><div class="notify-text">Script loaded successfully</div><div class="notify-time">42m ago</div></div>
          </div>
          <div class="notify-item">
            <div class="notify-dot blue"></div>
            <div><div class="notify-text">Fly mode activated</div><div class="notify-time">38m ago</div></div>
          </div>
          <div class="notify-item">
            <div class="notify-dot amber"></div>
            <div><div class="notify-text">Player <strong>Robloxian_X</strong> joined</div><div class="notify-time">21m ago</div></div>
          </div>
          <div class="notify-item">
            <div class="notify-dot red"></div>
            <div><div class="notify-text">Anti-cheat detected — bypassed</div><div class="notify-time">15m ago</div></div>
          </div>
          <div class="notify-item">
            <div class="notify-dot blue"></div>
            <div><div class="notify-text">ESP enabled for 12 players</div><div class="notify-time">10m ago</div></div>
          </div>
        </div>

      </div>
    </div>

  </main>
</div>

<!-- Toast Notification -->
<div id="toast" class="toast" style="display:none">
  <div class="toast-bar"></div>
  <div class="toast-content">
    <div class="toast-icon">✅</div>
    <div>
      <div class="toast-title">Settings Opened</div>
      <div class="toast-msg">Theme and config options loaded.</div>
    </div>
  </div>
</div>

<script>
  // CMD search filter
  document.querySelector('.search-input').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.cmd-item').forEach(item => {
      item.style.display = item.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
  });

  // Cmdbar execute
  document.querySelector('.cmdbar').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && this.value.trim()) {
      const toast = document.getElementById('toast');
      toast.querySelector('.toast-title').textContent = 'Command Sent';
      toast.querySelector('.toast-msg').textContent = `Executed: ;${this.value.trim()}`;
      toast.querySelector('.toast-icon').textContent = '⚡';
      toast.style.display = 'block';
      setTimeout(() => toast.style.display = 'none', 3000);
      this.value = '';
    }
  });

  // Active nav
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
    });
  });
</script>

</body>
</html>
